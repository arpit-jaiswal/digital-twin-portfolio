# Required: your OpenRouter API key (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: which model the digital twin chat uses.
# Any chat model available on OpenRouter works (https://openrouter.ai/models).
# Defaults to nvidia/nemotron-3-super-120b-a12b:free if not set.
# Note: free-tier model slugs on OpenRouter get discontinued/renamed over time —
# if chat starts failing, check https://openrouter.ai/models?max_price=0 for a current one.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
